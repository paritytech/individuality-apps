# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (unanchored: workspace packages too)
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
/apps/jollity-app/.next/
/apps/jollity-app/.next-host-*
/apps/jollity-app/build/
/apps/jollity-app/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent state: sessions, settings, editor rules
.claude/*
!.claude/skills/
.claude/sessions/
.claude/settings.local.json
.cursor/

# e2e run transcripts — generated, shareable, not source
scripts/out/

# truapi-host dev sessions (the local signer identity) — `npm run dev:host`
.truapi-host/

# local dot CLI workspace — accounts.json holds plain-text keys, never commit
.polkadot/

# The built chat bundle, which both deploy workflows make with `npm run build:chat`.
apps/jollity-worker/dist/
scripts/tmp-console.mjs

# python bytecode from the diagram scripts
__pycache__/

# e2e (Playwright): screenshots + review are produced artifacts
/apps/jollity-app/e2e/screenshots/
/apps/jollity-app/e2e/test-results/
/apps/jollity-app/e2e/report/
/playwright-report/
/test-results/
/apps/jollity-app/playwright-report/
/apps/jollity-app/test-results/
/apps/jollity-app/e2e/perf/results/
/apps/jollity-app/e2e/perf/baseline/
/apps/jollity-app/e2e/perf/test-results/

# agent-local state, never committed: Codex worktrees and advisor records
/.codex/
/.agents/

# dim2-sentry game report tooling: the local Sentry telemetry store and the
# skill's Python venv are runtime output, never committed (same as the archive)
/docs-internal/telemetry-store/
/.claude/skills/dim2-sentry/.venv/

# the state-machine explorer's mutants: sibling copies written at run time (lib/explorer/mutants/load.ts)
apps/jollity-app/lib/**/*.mutant-*.ts

