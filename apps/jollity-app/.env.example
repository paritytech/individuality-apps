# Copy to apps/jollity-app/.env.local:
#   cp apps/jollity-app/.env.example apps/jollity-app/.env.local
# Next reads .env files from this folder only, never from the repository root.
# A variable exported in the shell wins over the file (npm run dev:host sets its own).

# The network the app reads: previewnet, paseo or local. Required.
NEXT_PUBLIC_NETWORK_NAME=previewnet

# Optional: a test Sentry project's DSN. A page served from a developer's machine
# reports there instead of to NEXT_PUBLIC_SENTRY_DSN (lib/telemetry/init.ts).
# NEXT_PUBLIC_SENTRY_DSN_TEST=

# Optional: the label of the Humanity build whose storage holds the sign-ups its
# home makes (lib/host/game-registration.ts). Empty reads peopl.<tld>.
# NEXT_PUBLIC_HUMANITY_STORAGE_LABEL=

# Local mode: set NEXT_PUBLIC_NETWORK_NAME=local and all six settings below.
# On local, both executables read the app env files. Shell variables win.
# Hosted worker builds keep shell-only settings.
# URLs allow no credentials or fragments. Hashes are 0x plus 64 hex characters.
# Supply your own hashes and collection IDs; the values are public build settings.
# NEXT_PUBLIC_PEOPLE_WS=ws://127.0.0.1:9944
# NEXT_PUBLIC_PEOPLE_GENESIS=
# NEXT_PUBLIC_ASSET_HUB_WS=ws://127.0.0.1:9945
# NEXT_PUBLIC_ASSET_HUB_GENESIS=
# Required identity/TURN backend for the local People rings; no hosted default.
# NEXT_PUBLIC_DEVICE_UNIQUENESS_BACKEND_URL=http://127.0.0.1:8080
# Required local approval list of unsigned 32-bit collection IDs, for example 17,18.
# NEXT_PUBLIC_LOCAL_APPROVED_COLLECTIONS=
