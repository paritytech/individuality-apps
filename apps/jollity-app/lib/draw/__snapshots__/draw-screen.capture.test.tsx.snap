    "   100 mountWheel ticket won=true tickets=24 held=false",
    "   100 dom: wheel",
    "  1000 — the page turns hidden",
    "  4000 — the page turns visible",
    "  5000 — the stage offers its Continue",
    "  5000 startAutoClaim 7:0",
    "  6000 — the stage is done (its Continue pressed, a loss's fall played)",
    "  6000 reportDrawCeremony {"totalMs":5900,"loadMs":0,"endingMs":4900,"continueVisibleMs":1000,"hiddenMs":3000,"ended":true,"tapped":true,"idleAdvanced":false,"fallbackReason":"none"}",
    "  6000 markSeen 7 draw",
    "  6000 router.replace /chest?game=7",
    "  6000 startAutoClaim 7:0",
    "  6000 preloadChestFeed",
  ],
}
`;
