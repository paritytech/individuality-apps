# Copy to apps/humanity-app/.env.local (or export in the shell). `npm run humanity:setup` reads this
# cascade for the deploy. Both app and worker Vite configs read env files here,
# including `.env.local`, for builds and app development;
# an empty/absent .env uses Paseo Next V2. Selecting local requires all four
# VITE_LOCAL_* values below.
#
# Run `npm install` once at the repo root before the first dev start.

# Network key for the SPA chain registry. `paseo-next-v2` and `previewnet`
# and `local` are defined; empty uses paseo-next-v2.
VITE_NETWORK=

# Required only for VITE_NETWORK=local, in both app and worker builds.
# URLs must use ws:// or wss://, with no credentials or fragment.
# Hashes must be 0x followed by exactly 64 hex characters, from your chains.
# Missing or malformed values stop Vite config resolution with the variable name.
VITE_LOCAL_PEOPLE_WS_URL=
VITE_LOCAL_PEOPLE_GENESIS_HASH=
VITE_LOCAL_ASSET_HUB_WS_URL=
VITE_LOCAL_ASSET_HUB_GENESIS_HASH=

# Override the People-chain WS endpoint (e.g. a local zombienet node at
# ws://localhost:10010). Empty uses the registry default for VITE_NETWORK.
# Ignored for local: VITE_LOCAL_PEOPLE_WS_URL is the only People endpoint there.
VITE_PEOPLE_WS_URL=

# Replace the hosted network's built-in genesis hashes (0x + 64 hex each).
# Previewnet's genesis rotates on every reset; set these to build for a reset
# previewnet before packages/humanity-shared/src/chain/networks.ts is updated.
# Empty uses the registry's. Ignored for local.
VITE_PEOPLE_GENESIS_HASH=
VITE_ASSET_HUB_GENESIS_HASH=

# The `dim2.<suffix>` product-account index the weekly game is played on: the
# candidate account the card, the game, the seat and personhood registration
# all use. Empty uses 1, where Jollity signs people up.
VITE_GAME_ACCOUNT_INDEX=

# DotNS label the host wallet derives the app-scoped product account from
# (SS58 prefix 42) — `//product//<this>.<suffix>/0`. BARE LABEL ONLY —
# the suffix is supplied by VITE_NETWORK (`.paseo` on paseo-next-v2,
# `.testnet` on previewnet and local), not by this file. Setting a suffix here is
# refused at startup. For direct Vite dev/test starts, empty/absent
# falls back to "peopl" (the RFC-0022 personhood id) in the app.
# `npm run humanity:setup` overwrites this from DOTNS_LABEL (or --product-label)
# for the target network.
VITE_DOTNS_PRODUCT_LABEL=

# Browser-side LogTape log level (fatal | error | warning | info | debug |
# trace). Set `debug` to trace the prize/card chain reads.
VITE_LOG_LEVEL=info

# Sentry: your own project's DSN. Empty/absent compiles telemetry in but
# never starts it, so nothing is sent anywhere. The user flows it reports,
# and what each carries, are listed in docs/telemetry.md.
VITE_SENTRY_DSN=
# Share of flow transactions kept, 0..1 (default 0.1). Errors are never
# sampled. Set 1 locally to see every flow of your own run.
VITE_SENTRY_TRACES_SAMPLE_RATE=
# `true` to include usernames and account addresses in reports. Off unless
# set: reports then carry the card's standing but not whose card it is.
VITE_SENTRY_SEND_IDENTITY=
# Source-map upload to your Sentry project at build time (never VITE_-
# prefixed: the token is a build credential). All three, or no upload. Vite
# does not load these from env files: export them, or build through
# `npm run humanity:setup`, which reads this file into the build's environment.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Build the "state" debug overlay in (true) or leave it out (false). Unset
# follows the build: present in `npm run humanity:dev`, absent in a production
# build. It signs only as the person's own accounts.
VITE_DEBUG_PANEL=

# ─── Deployment (`npm run humanity:setup`) ────────────────────────────────────
#
# `npm run humanity:setup` reads this file, builds apps/humanity-app with the
# VITE_* values above, and hands the bundle to the `bulletin-deploy`
# CLI. Install it first: npm install -g bulletin-deploy@0.25.0
#
# Preview the resolved plan without building or deploying:
#   npm run humanity:setup -- --dry-run

# DotNS owner phrase that signs the deploy: the account that owns your
# DOTNS_LABEL on the target network. 12 or 24 words. Required for a
# deploy (a --dry-run runs without it) — setup refuses to deploy without it
# rather than let bulletin-deploy fall back to a shared dev account. Never
# commit a real value (.env is gitignored; MNEMONIC is accepted as an alias).
DOTNS_MNEMONIC=

# Target environment. `preview` deploys <label>.testnet via testnet.li;
# `paseo-next-v2` deploys <label>.paseo via paseo.li. The TLD and gateway
# are checked against the network's Trinity stack descriptor, not set here.
#
# Leave empty to follow VITE_NETWORK above (previewnet -> preview,
# paseo-next-v2 -> paseo-next-v2). Setting both to disagreeing networks
# is refused. Local is build/dev only and is not a deploy target.
# A mismatched bundle would read a chain other than the one it is
# deployed on.
BULLETIN_ENV=
# Your bare DotNS label the deploy is served under — no suffix; the
# environment supplies the TLD. A deploy requires this value and derives
# VITE_DOTNS_PRODUCT_LABEL from it; a --dry-run plans for `peopl` without it.
# `peopl` itself is the RFC-0022 governance-reserved personhood id: only an
# account that owns it (or is whitelisted for reserved labels) can deploy it.
DOTNS_LABEL=

# Set to `true` to also list the name in the on-chain Publisher registry
# (Browse directory). Neither deploy target has a Publisher registry today,
# so setup refuses `true`.
BULLETIN_DEPLOY_PUBLISH=false

# Cross-product grants written into the product manifest: a JSON object from
# a bare product label to its grants ("context", "storage"), e.g.
#   HUMANITY_TRUSTED_PRODUCTS={"dim2":["context","storage"]}
# Empty grants nothing. `context` lets that product sign as this one, so list
# only products whose names you own or trust on the target network. See
# deploy/bulletin-deploy.config.ts.
HUMANITY_TRUSTED_PRODUCTS=

# Trinity stack descriptor links the deploy's TLD and gateway are checked
# against (`polkadotapp://stack?key=…&url=…`). Empty uses the built-in link for
# preview; paseo-next-v2 has none, so its check is skipped unless set.
HUMANITY_STACK_LINK_PREVIEW=
HUMANITY_STACK_LINK_PASEO_NEXT_V2=
